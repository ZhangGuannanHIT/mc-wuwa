{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "gui",
        "model": {
          "type": "minecraft:model",
          "model": "mc_wuwa:item/stellar_symphony_icon"
        }
      },
      {
        "when": [
          "fixed",
          "ground"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "mc_wuwa:item/stellar_symphony_display"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "mc_wuwa:item/stellar_symphony_3d"
    }
  }
}
